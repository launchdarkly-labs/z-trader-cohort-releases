    {
      "key": "dark-mode",
      "name": "Dark Mode",
      "kind": "boolean",
      "description": "Dark theme for the trading app. Released one city at a time - Delhi, then Jaipur, then Goa - with a guarded rollout on each phase so a regression rolls back that city alone. The only dark-mode flag the app asks for.",
      "variations": [
        {
          "value": true
        },
        {
          "value": false
        }
      ],
      "defaults": {
        "onVariation": 0,
        "offVariation": 1
      },
      "clientSideAvailability": {
        "usingEnvironmentId": true
      },
      "environments": {
        "production": {
          "on": true,
          "offVariation": 1,
          "rules": [
            {
              "description": "Delhi",
              "clauses": [
                {
                  "contextKind": "user",
                  "attribute": "region",
                  "op": "in",
                  "values": [
                    "Delhi"
                  ]
                }
              ],
              "variation": 1
            },
            {
              "description": "Jaipur",
