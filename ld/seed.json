                {
                  "contextKind": "user",
                  "attribute": "region",
                  "op": "in",
                  "values": [
                    "Goa"
                  ]
                }
              ],
              "variation": 1
            }
          ],
          "fallthrough": {
            "variation": 1
          }
        }
      }
    },
