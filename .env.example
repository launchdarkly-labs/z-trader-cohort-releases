# Copy to .env and fill in the four credentials. .env is gitignored — never
# commit real values. Every dial below is set to the value the demo is tuned
# for, so you can copy this file and run it as-is.

# --- LaunchDarkly project / environment (parameterised, not hardcoded) -------
LD_PROJECT_KEY=your-project-key
LD_ENVIRONMENT_KEY=production

# --- Credentials -------------------------------------------------------------
# Server-side SDK key for the environment above (secret — backend only). Starts sdk-.
LD_SDK_KEY=REPLACE_WITH_YOUR_SDK_KEY
# Client-side ID for the same environment (public by design — it ships in the
# browser JS of the demo page). Settings -> Environments -> client-side ID.
LD_CLIENT_SIDE_ID=REPLACE_WITH_YOUR_CLIENT_SIDE_ID
# REST API token with Writer access, starts api-. Needed by launchdarkly/ and
# every script in scripts/.
LAUNCHDARKLY_ACCESS_TOKEN=REPLACE_WITH_YOUR_API_TOKEN

# --- Traffic ------------------------------------------------------------------
# Sessions per minute, PER POPULATION (the city demo and the per-OS demo each
# get this many). Keep >= 600 so the smallest group reaches the guarded-rollout
# per-step minimum while only 10% of it is exposed.
SESSIONS_PER_MINUTE=1200
# Share of sessions per city: Delhi,Jaipur,Goa (must sum to 100).
REGION_MIX=45,35,20
# Share of sessions per OS version: iOS18,iOS17,iOS16 (must sum to 100).
OS_MIX=55,30,15
# both | one | optiona — run both populations, or just one of them.
DEMO_MODE=both

# --- The fault the release is supposed to catch -------------------------------
# City whose traders hit the dark-mode fault (delhi | jaipur | goa).
BUGGY_REGION=jaipur
# OS version with the fault, for the flag-per-OS comparison (ios18|ios17|ios16).
BUGGY_COHORT=ios17
# Render-error rate in the affected group when dark mode is ON.
FAILURE_RATE=0.50
# Healthy groups emit ZERO errors, so a healthy rollout cannot false-positive on
# a one-minute sample. Raise it only if you want to show noise.
BASELINE_ERROR_RATE=0
# true = the "fix forward" beat: the affected group behaves normally.
FIX_APPLIED=false
# Dashboard row turns red above this render-error %.
ERROR_THRESHOLD_PCT=5

# --- quote-experience experiment (the device-capability story) ----------------
# Order completion per variation, per iOS18,iOS17,iOS16. These numbers are the
# experiment's conclusion: the live stream wins clearly on iOS 18, is marginal
# on iOS 17, and loses even to pull-to-refresh on iOS 16. Change them and the
# experiment tells a different story.
QE_ORDERS_STATIC=0.060,0.060,0.060
QE_ORDERS_POLLED=0.085,0.080,0.075
QE_ORDERS_LIVE=0.130,0.090,0.040
# Extra render milliseconds each variation costs, per iOS18,iOS17,iOS16. This is
# why the richest experience loses on the oldest hardware.
QE_LOAD_STATIC=0,0,0
QE_LOAD_POLLED=10,25,60
QE_LOAD_LIVE=15,120,520

# --- pnl-display experiment (the one any stakeholder can read) ----------------
# Share of sessions that open a holding, per variation. Showing the rupee amount
# is expected to draw more taps than a bare percentage.
HOLDING_TAP_PERCENT=0.22
HOLDING_TAP_RUPEES=0.29

# --- Order flow ----------------------------------------------------------------
# Baseline order completion, used when no quote-experience value applies.
ORDER_RATE_BASE=0.08
# Share of placed orders cancelled shortly after — the mis-trade guardrail.
CANCEL_TWO_STEP=0.005

# --- Observability --------------------------------------------------------------
# false disables the errors/logs/traces/session-replay plugins. The demo runs
# identically without them, which is the kill switch if a plugin misbehaves.
OBSERVABILITY=true

# --- Demo page (app/demo.js) ------------------------------------------------------
DEMO_PORT=8765
# Fixed contexts sampled per group for the fleet wall, and tiles drawn. The pool
# is fixed on purpose: fresh keys every tick would flood a rollout with
# metric-free devices and let a release complete with "no regressions detected".
VIEWER_POOL=150
VIEWER_TILES=18
# Candidate identities the on-screen phone can adopt, so it can hop onto a
# device that is actually inside the rollout.
APP_POOL=12
# Only used by the standalone app/viewer.js.
VIEWER_PORT=8766
